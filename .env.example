ACCESS_TOKEN=
SHOPIFY_DOMAIN=
SHOPIFY_API_SECRET=


# Customer Creation Settings
# =========================
# Total number of customers to create
TOTAL_CUSTOMERS=500000

# Number of customers to process in each batch
BATCH_SIZE=10

# Maximum API calls per second for customer creation
API_CALLS_PER_SECOND=2

# Size of chunks for progress tracking and resuming
CHUNK_SIZE=1000

# Customer data customization
CUSTOMER_TAGS=API_Created, Bulk_Import, VIP

# Order Creation Settings
# ======================
# Whether to create orders for customers (true/false)
CREATE_ORDERS=true

# Number of orders to create per customer
ORDERS_PER_CUSTOMER=1

# Maximum API calls per second for order creation
# Note: This should typically be lower than customer API rate
ORDER_RATE_LIMIT=0.2

# Number of orders to process in each batch
ORDER_BATCH_SIZE=1

# Size of chunks for order creation progress tracking
ORDER_CHUNK_SIZE=10

# Order status (completed, fulfilled, unfulfilled, etc.)
ORDER_STATUS=completed

# Financial status for orders (paid, pending, refunded, etc.)
ORDER_FINANCIAL_STATUS=paid

# Fulfillment status for orders (fulfilled, partial, unfulfilled, etc.)
ORDER_FULFILLMENT_STATUS=fulfilled
